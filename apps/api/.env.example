# Base de données (dev)
DATABASE_URL="postgresql://shakespeare:shakespeare@localhost:5544/shakespeare_academy?schema=public"

# Base de données dédiée aux tests e2e (jamais la même que DATABASE_URL)
TEST_DATABASE_URL="postgresql://shakespeare:shakespeare@localhost:5544/shakespeare_academy_test?schema=public"

# Secrets JWT (générer des valeurs aléatoires réelles avant toute mise en production)
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_TTL="7d"

# Alertes push aux parents (Lot 12, gratuites, standard Web Push). Générer une paire de clés :
#   node -e "const w=require('web-push');console.log(w.generateVAPIDKeys())"
# Vides = aucune alerte push (les notifications restent dans l'application). Changer la paire de clés
# invalide tous les appareils déjà enregistrés.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="https://academy.lobima.online"

PORT=3001
