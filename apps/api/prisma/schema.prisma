// Shakespeare Academy — schéma Prisma.
// Lot 1 (socle) : établissement, années, structure académique, utilisateurs/rôles/permissions, audit.
// Lot 2 : élèves, responsables, inscriptions/réinscriptions (sans paiement).
// Les entités de facturation/paiement/caisse (Lots 3-5) ne sont volontairement pas modélisées ici :
// plusieurs règles dont elles dépendent sont encore ouvertes (voir DECISIONS_PENDING.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Établissement ---------------------------------------------------------

model School {
  id            String   @id @default(cuid())
  nom           String
  adresse       String?
  telephone     String?
  email         String?
  logoUrl       String?
  devise        String   @default("XAF")
  fuseauHoraire String   @default("Africa/Brazzaville")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Seuil configurable (jamais inventé) au-delà duquel un montant exigible en retard fait basculer
  // le statut de solvabilité de EN_RETARD à IMPAYE_CRITIQUE (cahier §6). `null` = fonctionnalité
  // inactive : le statut restera toujours EN_RETARD, jamais IMPAYE_CRITIQUE, tant qu'il n'est pas réglé.
  seuilImpayeCritiqueFcfa Int?

  academicYears   AcademicYear[]
  sections        Section[]
  users           User[]
  auditLogs       AuditLog[]
  numberSequences NumberSequence[]
  students        Student[]
  guardians       Guardian[]
  enrollments     Enrollment[]
  feeTypes        FeeType[]
  feeSchedules    FeeSchedule[]
  invoices        Invoice[]
  payments        Payment[]
  expenses        Expense[]

  @@map("schools")
}

// --- Années scolaires --------------------------------------------------------

enum AcademicYearStatus {
  BROUILLON
  ACTIVE
  CLOTUREE
}

model AcademicYear {
  id                    String             @id @default(cuid())
  schoolId              String
  school                School             @relation(fields: [schoolId], references: [id])
  libelle               String
  dateDebut             DateTime
  dateFin               DateTime
  statut                AcademicYearStatus @default(BROUILLON)
  dateDebutInscriptions DateTime?
  dateFinInscriptions   DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  classes      Class[]
  enrollments  Enrollment[]
  feeSchedules FeeSchedule[]

  @@unique([schoolId, libelle])
  @@map("academic_years")
}

// --- Structure académique : Section → Cycle → Niveau → Classe --------------
// Modèle recommandé par le cahier de cadrage (§2) : le niveau porte le programme,
// la classe porte le groupe réel pour une année scolaire donnée.

model Section {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  code      String
  nom       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycles Cycle[]

  @@unique([schoolId, code])
  @@map("sections")
}

model Cycle {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])
  code      String
  nom       String
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levels Level[]

  @@unique([sectionId, code])
  @@map("cycles")
}

model Level {
  id        String   @id @default(cuid())
  cycleId   String
  cycle     Cycle    @relation(fields: [cycleId], references: [id])
  code      String
  nom       String
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes      Class[]
  feeSchedules FeeSchedule[]

  @@unique([cycleId, code])
  @@map("levels")
}

model Class {
  id             String       @id @default(cuid())
  levelId        String
  level          Level        @relation(fields: [levelId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  nom            String
  // serie/groupe : colonnes prévues par anticipation de D02 (séries de lycée, sous-groupes de classe),
  // jamais renseignées automatiquement tant que D02 reste ouvert.
  serie          String?
  groupe         String?
  capacite       Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  enrollments Enrollment[]

  @@unique([levelId, academicYearId, nom])
  @@map("classes")
}

// --- Utilisateurs, rôles, permissions ---------------------------------------
// Permissions fines (pas seulement par rôle) : un Role est une collection de Permission,
// vérifiée à chaque requête sensible par un guard serveur, jamais par le seul rôle affiché côté client.

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  nom         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

enum UserStatus {
  ACTIF
  INACTIF
}

model User {
  id                        String     @id @default(cuid())
  schoolId                  String
  school                    School     @relation(fields: [schoolId], references: [id])
  roleId                    String
  role                      Role       @relation(fields: [roleId], references: [id])
  nom                       String
  prenom                    String
  email                     String
  motDePasseHash            String
  statut                    UserStatus @default(ACTIF)
  dernierLoginAt            DateTime?
  // Politique de verrouillage (§14) : compteur d'échecs consécutifs et verrou temporaire, jamais un blocage définitif.
  tentativesEchecsConnexion Int        @default(0)
  verrouilleJusqua          DateTime?
  // Récupération administrée (§8) : un admin fixe un mot de passe temporaire, l'utilisateur doit le changer à la connexion suivante.
  doitChangerMotDePasse     Boolean    @default(false)
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  discountsProposed  Discount[]     @relation("DiscountAuteur")
  discountsDecided   Discount[]     @relation("DiscountApprobateur")
  paymentsRecus      Payment[]
  paymentsAnnules    Payment[]      @relation("PaymentAnnulePar")
  expensesEffectuees Expense[]      @relation("ExpenseEffectuePar")
  expensesApprouvees Expense[]      @relation("ExpenseApprobateur")

  @@unique([schoolId, email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// --- Séquences numériques atomiques ------------------------------------------
// RG10 (par extension aux matricules/numéros d'inscription, avant même les reçus du Lot 4) :
// un numéro généré ici est unique et jamais réutilisé. `scope` vaut "" pour une séquence non
// rattachée à une année (matricule, permanent) ou l'id d'une AcademicYear (numéro d'inscription,
// par année) — chaîne vide plutôt que `null` pour rester utilisable dans une contrainte unique.

model NumberSequence {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  type          String
  scope         String   @default("")
  dernierNumero Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, type, scope])
  @@map("number_sequences")
}

// --- Élèves, responsables, inscriptions (Lot 2) -----------------------------
// Aucun montant, facture ni paiement ici (Lots 3-4) : plusieurs règles dont ils dépendent
// restent ouvertes (DECISIONS_PENDING.md). "Alerte impayés antérieurs" à la réinscription
// (cadrage §4.2) n'est donc pas encore implémentable — reportée au Lot 4.

enum Sexe {
  M
  F
}

enum StudentStatus {
  ACTIF
  INACTIF
}

model Student {
  id            String        @id @default(cuid())
  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id])
  matricule     String
  nom           String
  prenom        String
  sexe          Sexe
  dateNaissance DateTime
  nationalite   String?
  photoUrl      String?
  statut        StudentStatus @default(ACTIF)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  studentGuardians StudentGuardian[]
  enrollments      Enrollment[]

  @@unique([schoolId, matricule])
  @@map("students")
}

model Guardian {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  nom        String
  prenom     String
  telephone  String
  email      String?
  profession String?
  adresse    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  studentGuardians StudentGuardian[]

  // R9-like (cf. Elyon) : un même numéro identifie le même responsable au sein d'un établissement,
  // jamais par téléphone seul à travers plusieurs écoles (non pertinent ici, mono-établissement,
  // mais évite qu'un même parent soit dupliqué à chaque nouvel enfant inscrit).
  @@unique([schoolId, telephone])
  @@map("guardians")
}

model StudentGuardian {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  guardianId  String
  guardian    Guardian @relation(fields: [guardianId], references: [id])
  lien        String
  prioritaire Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([studentId, guardianId])
  @@map("student_guardians")
}

enum EnrollmentType {
  INSCRIPTION
  REINSCRIPTION
}

enum EnrollmentStatus {
  ACTIVE
  ANNULEE
}

model Enrollment {
  id              String           @id @default(cuid())
  schoolId        String
  school          School           @relation(fields: [schoolId], references: [id])
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id])
  classId         String
  class           Class            @relation(fields: [classId], references: [id])
  academicYearId  String
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id])
  numero          String
  type            EnrollmentType
  statut          EnrollmentStatus @default(ACTIVE)
  dateInscription DateTime         @default(now())
  motifAnnulation String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  invoice Invoice?

  @@unique([schoolId, numero])
  @@map("enrollments")
}

// --- Tarifs, factures, remises (Lot 3) --------------------------------------
// Aucun paiement ici (Lot 4) : "montant payé" est donc toujours 0 pour l'instant.
// Le statut de solvabilité (cahier §6) reflète honnêtement cette absence — RG13, jamais une donnée
// inventée : tant que le Lot 4 n'existe pas, tout montant exigible apparaît normalement non couvert.

// D39 (DECISIONS_PENDING.md) : certains frais ne s'appliquent qu'à un type d'inscription précis
// (ex. "Frais d'inscription" pour un nouvel élève, "Frais de réinscription" pour un élève déjà
// connu) — jamais les deux à la fois pour la même inscription, `TOUS` reste le défaut pour un
// frais indifférent au type (ex. l'écolage).
enum FeeApplicability {
  TOUS
  INSCRIPTION
  REINSCRIPTION
}

model FeeType {
  id           String           @id @default(cuid())
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id])
  code         String
  nom          String
  obligatoire  Boolean          @default(true)
  avecTranches Boolean          @default(false)
  appliesTo    FeeApplicability @default(TOUS)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  feeSchedules FeeSchedule[]
  invoiceLines InvoiceLine[]

  @@unique([schoolId, code])
  @@map("fee_types")
}

model FeeSchedule {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  levelId        String
  level          Level        @relation(fields: [levelId], references: [id])
  feeTypeId      String
  feeType        FeeType      @relation(fields: [feeTypeId], references: [id])
  // Requis si feeType.avecTranches = false (montant unique). Ignoré sinon (voir InstallmentSchedule).
  montant        Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  installments InstallmentSchedule[]

  @@unique([academicYearId, levelId, feeTypeId])
  @@map("fee_schedules")
}

model InstallmentSchedule {
  id              String      @id @default(cuid())
  feeScheduleId   String
  feeSchedule     FeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)
  libelle         String
  montant         Int
  ordre           Int
  dateLimite      DateTime
  delaiGraceJours Int         @default(0)
  createdAt       DateTime    @default(now())

  @@unique([feeScheduleId, ordre])
  @@map("installment_schedules")
}

enum InvoiceStatus {
  EMISE
  ANNULEE
}

model Invoice {
  id           String        @id @default(cuid())
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id])
  enrollmentId String        @unique
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id])
  statut       InvoiceStatus @default(EMISE)
  dateEmission DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lines InvoiceLine[]

  @@map("invoices")
}

model InvoiceLine {
  id              String    @id @default(cuid())
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeTypeId       String
  feeType         FeeType   @relation(fields: [feeTypeId], references: [id])
  // Snapshot (RG03) : jamais recalculé après coup, même si le tarif change ensuite.
  libelle         String
  montant         Int
  dateEcheance    DateTime?
  delaiGraceJours Int       @default(0)
  ordre           Int       @default(0)
  createdAt       DateTime  @default(now())

  discounts Discount[]
  payments  Payment[]

  @@map("invoice_lines")
}

// --- Paiements et reçus (Lot 4) ---------------------------------------------
// Un paiement cible toujours une seule InvoiceLine, jamais réparti sur plusieurs (simplification
// délibérée qui évite tout le débat D12 sur la ventilation multi-lignes : le montant est toujours
// plafonné au solde restant de CETTE ligne, donc un trop-perçu au sens RG08 est structurellement
// impossible sans qu'un compte d'avance existe — voir DECISIONS_PENDING.md D41). Paiement partiel
// autorisé (D10, plusieurs paiements possibles sur la même ligne jusqu'à solde nul). RG09/RG18 :
// jamais modifié ni supprimé une fois VALIDE — une correction passe par ANNULE + motif (écriture
// inverse implicite, le solde de la ligne se recalcule simplement en excluant les paiements ANNULE).

enum PaymentMode {
  ESPECES
  MOBILE_MONEY
}

enum PaymentStatus {
  VALIDE
  ANNULE
}

model Payment {
  id               String        @id @default(cuid())
  schoolId         String
  school           School        @relation(fields: [schoolId], references: [id])
  invoiceLineId    String
  invoiceLine      InvoiceLine   @relation(fields: [invoiceLineId], references: [id])
  numeroRecu       String
  // Vérification d'authenticité du reçu (D29) : jeton aléatoire distinct de numeroRecu (séquentiel
  // et donc devinable) — sert de clé pour GET /payments/verify/:token, un endpoint public qui ne
  // doit jamais permettre d'énumérer tous les reçus de l'école en incrémentant un numéro.
  verificationToken String       @unique @default(cuid())
  // Encaissement saisi sans Internet (D49) : numéro du reçu PROVISOIRE remis au parent (généré sur
  // l'appareil, jamais un numéro officiel) et instant réel de la saisie. Le reçu officiel REC-xxxxxx
  // n'est attribué qu'à la synchronisation, par le serveur (RG10 inchangée).
  numeroProvisoire  String?
  saisieHorsLigneAt DateTime?
  montant          Int
  modePaiement     PaymentMode   @default(ESPECES)
  // Renseignée uniquement pour MOBILE_MONEY (référence externe de la transaction) — jamais
  // d'intégration API automatisée, un simple enregistrement manuel (cahier §11, déjà tranché).
  referenceExterne String?
  datePaiement     DateTime      @default(now())
  recuParUserId    String
  recuParUser      User          @relation(fields: [recuParUserId], references: [id])
  statut           PaymentStatus @default(VALIDE)
  motifAnnulation  String?
  annuleParUserId  String?
  annuleParUser    User?         @relation("PaymentAnnulePar", fields: [annuleParUserId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([schoolId, numeroRecu])
  @@unique([schoolId, numeroProvisoire])
  @@map("payments")
}

enum DiscountType {
  MONTANT_FIXE
  POURCENTAGE
}

enum DiscountStatus {
  EN_ATTENTE
  APPROUVEE
  REJETEE
}

model Discount {
  id            String         @id @default(cuid())
  invoiceLineId String
  invoiceLine   InvoiceLine    @relation(fields: [invoiceLineId], references: [id])
  type          DiscountType
  valeur        Int
  motif         String
  statut        DiscountStatus @default(EN_ATTENTE)
  auteurId      String
  auteur        User           @relation("DiscountAuteur", fields: [auteurId], references: [id])
  approbateurId String?
  approbateur   User?          @relation("DiscountApprobateur", fields: [approbateurId], references: [id])
  motifRejet    String?
  dateDecision  DateTime?
  createdAt     DateTime       @default(now())

  @@map("discounts")
}

// --- Journal d'audit (append-only) ------------------------------------------
// RG15 : toute action sensible est journalisée avec utilisateur, horodatage, ancienne et nouvelle valeur.
// Aucune méthode de mise à jour/suppression n'est exposée par le service applicatif (voir AuditService).

// Clé d'idempotence (en-tête Idempotency-Key) : rejouer une requête déjà traitée renvoie la réponse
// d'origine au lieu de refaire l'opération — indispensable à la synchronisation hors ligne, où une
// réponse perdue par le réseau fait renvoyer la même saisie. Sans clé étrangère (simple journal).
model IdempotencyRecord {
  id         String   @id @default(cuid())
  userId     String
  key        String
  method     String
  path       String
  statusCode Int
  response   Json?
  createdAt  DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

model AuditLog {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  action         String
  entite         String
  entiteId       String?
  ancienneValeur Json?
  nouvelleValeur Json?
  createdAt      DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([entite, entiteId])
  @@map("audit_logs")
}

// --- Sorties financières (Lot 5) ---------------------------------------------
// D24 (DECISIONS_PENDING.md) : catégorie fermée mais volontairement PAS un enum Postgres — une
// simple chaîne validée côté DTO (`EXPENSE_CATEGORIES`) pour rester "paramétrable" sans migration
// si l'école demande une catégorie de plus. D25 : toute sortie exige une validation Direction
// (seuil = 0, provisoire) avant d'être comptée comme une vraie sortie de caisse.

enum ExpenseStatus {
  EN_ATTENTE
  APPROUVEE
  REJETEE
}

model Expense {
  id            String        @id @default(cuid())
  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id])
  categorie     String
  montant       Int
  description   String
  dateDepense   DateTime      @default(now())
  statut        ExpenseStatus @default(EN_ATTENTE)
  effectueParId String
  effectuePar   User          @relation("ExpenseEffectuePar", fields: [effectueParId], references: [id])
  approbateurId String?
  approbateur   User?         @relation("ExpenseApprobateur", fields: [approbateurId], references: [id])
  motifRejet    String?
  dateDecision  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("expenses")
}
