// Shakespeare Academy — schéma Prisma.
// Lot 1 (socle) : établissement, années, structure académique, utilisateurs/rôles/permissions, audit.
// Lot 2 : élèves, responsables, inscriptions/réinscriptions (sans paiement).
// Les entités de facturation/paiement/caisse (Lots 3-5) ne sont volontairement pas modélisées ici :
// plusieurs règles dont elles dépendent sont encore ouvertes (voir DECISIONS_PENDING.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Établissement ---------------------------------------------------------

model School {
  id            String   @id @default(cuid())
  nom           String
  adresse       String?
  telephone     String?
  email         String?
  logoUrl       String?
  devise        String   @default("XAF")
  fuseauHoraire String   @default("Africa/Brazzaville")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Seuil configurable (jamais inventé) au-delà duquel un montant exigible en retard fait basculer
  // le statut de solvabilité de EN_RETARD à IMPAYE_CRITIQUE (cahier §6). `null` = fonctionnalité
  // inactive : le statut restera toujours EN_RETARD, jamais IMPAYE_CRITIQUE, tant qu'il n'est pas réglé.
  seuilImpayeCritiqueFcfa Int?

  // Lot 7 (D52, validée) : jours de classe, 0 = dimanche ... 6 = samedi. Lundi à vendredi par défaut,
  // le samedi s'active par paramètre. Jamais codé en dur dans la logique.
  joursClasse Int[] @default([1, 2, 3, 4, 5])

  // Lot 9 (D57, D58 : valeurs provisoires, modifiables par la Direction, jamais codées ailleurs).
  // Un élève arrivé après ce nombre de minutes est absent de la séance ; en deçà, il est en retard.
  retardMaxMinutes       Int @default(15)
  // Délai (en jours de classe) pour justifier une absence.
  delaiJustificatifJours Int @default(3)

  // Lot 10 (D62, D63 : valeurs provisoires modifiables par la Direction, jamais codées ailleurs).
  // On peut pointer le début d'une séance jusqu'à ce nombre de minutes avant son heure.
  pointageFenetreMinutes   Int @default(15)
  // Un début pointé plus de N minutes après l'heure prévue est signalé comme retard.
  pointageToleranceMinutes Int @default(10)
  // Deux pointages du même enseignant doivent être espacés d'au moins N minutes (double scan).
  pointageEcartMinMinutes  Int @default(5)

  // Lot 11 (D66 : valeur provisoire modifiable) : durée de validité d'un code d'activation de compte parent.
  parentCodeValiditeJours Int @default(30)

  // Lot 12 (D71 : valeur provisoire modifiable) : les changements d'emploi du temps sont regroupés :
  // tant qu'une notification du même type n'est pas lue et a moins de N minutes, elle est complétée
  // au lieu d'en envoyer une nouvelle (une seule alerte push par rafale).
  notifGroupeMinutes Int @default(60)

  // Lot 13 (D74, RV09 : valeurs provisoires modifiables). Délai de réponse indicatif affiché aux parents
  // (jours ouvrés), et nombre de chiffres à partir duquel un message est refusé car il ressemble à un
  // numéro de téléphone : aucun numéro personnel n'est échangé (RV09).
  messageDelaiReponseJours Int @default(2)
  messageNumeroMinChiffres Int @default(9)

  // Lot 14 (D61 : AUCUN seuil inventé). Nombre d'absences non justifiées, sur la période du tableau de bord,
  // à partir duquel un élève apparaît dans les alertes de décrochage. `null` = alertes désactivées : elles le
  // restent tant que la Direction n'a pas fixé un seuil.
  seuilAlerteAbsences Int?

  // Lot 15 (notes et bulletins, valeurs provisoires modifiables, jamais des constantes). Barème par défaut d'une
  // nouvelle évaluation ; moyenne de passage : `null` = aucune mention admis ou refusé (rien d'inventé).
  baremeDefaut         Int      @default(20)
  moyennePassage       Decimal? @db.Decimal(4, 2)
  // Le parent voit-il le rang de son enfant et les statistiques de la classe sur le bulletin ? Non par défaut (à décider).
  bulletinAfficheRang  Boolean  @default(false)
  // Interrupteur du paiement des frais par les parents (Mobile Money). Faux tant que l'Administrateur ne l'a pas activé.
  paiementEnLigneActif Boolean  @default(false)

  // Lot 19 (documents officiels) : ce qui figure sur une attestation (nom et titre du signataire, ville du lieu de
  // signature, image de la signature). Tous facultatifs : une attestation ne se génère que s'ils sont renseignés.
  directeurNom   String?
  directeurTitre String  @default("Le Directeur")
  ville          String?
  signatureUrl   String?

  academicYears     AcademicYear[]
  sections          Section[]
  users             User[]
  auditLogs         AuditLog[]
  numberSequences   NumberSequence[]
  students          Student[]
  guardians         Guardian[]
  enrollments       Enrollment[]
  feeTypes          FeeType[]
  feeSchedules      FeeSchedule[]
  invoices          Invoice[]
  payments          Payment[]
  onlinePayments    OnlinePayment[]
  issuedDocuments   IssuedDocument[]
  disciplineRecords DisciplineRecord[]
  preRegistrations  PreRegistration[]
  expenses          Expense[]
  rooms             Room[]
  timeSlots         TimeSlot[]
  subjects          Subject[]
  teachers          Teacher[]

  @@map("schools")
}

// --- Années scolaires --------------------------------------------------------

enum AcademicYearStatus {
  BROUILLON
  ACTIVE
  CLOTUREE
}

model AcademicYear {
  id                    String             @id @default(cuid())
  schoolId              String
  school                School             @relation(fields: [schoolId], references: [id])
  libelle               String
  dateDebut             DateTime
  dateFin               DateTime
  statut                AcademicYearStatus @default(BROUILLON)
  dateDebutInscriptions DateTime?
  dateFinInscriptions   DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  classes           Class[]
  enrollments       Enrollment[]
  feeSchedules      FeeSchedule[]
  terms             Term[]
  calendarEvents    CalendarEvent[]
  timetables        Timetable[]
  issuedDocuments   IssuedDocument[]
  disciplineRecords DisciplineRecord[]

  @@unique([schoolId, libelle])
  @@map("academic_years")
}

// --- Structure académique : Section → Cycle → Niveau → Classe --------------
// Modèle recommandé par le cahier de cadrage (§2) : le niveau porte le programme,
// la classe porte le groupe réel pour une année scolaire donnée.

model Section {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  code      String
  nom       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycles    Cycle[]
  timeSlots TimeSlot[]

  // Lot 15 : afficher les moyennes en lettres (A à F) sur les bulletins de cette section. Les tranches sont dans
  // `GradeBand`, saisies par la Direction ; tant qu'elles sont vides, aucune lettre n'est affichée.
  affichageLettres Boolean @default(false)

  @@unique([schoolId, code])
  @@map("sections")
}

model Cycle {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])
  code      String
  nom       String
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levels Level[]

  @@unique([sectionId, code])
  @@map("cycles")
}

model Level {
  id        String   @id @default(cuid())
  cycleId   String
  cycle     Cycle    @relation(fields: [cycleId], references: [id])
  code      String
  nom       String
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes          Class[]
  feeSchedules     FeeSchedule[]
  subjectLevels    SubjectLevel[]
  preRegistrations PreRegistration[]

  @@unique([cycleId, code])
  @@map("levels")
}

model Class {
  id             String       @id @default(cuid())
  levelId        String
  level          Level        @relation(fields: [levelId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  nom            String
  // serie/groupe : colonnes prévues par anticipation de D02 (séries de lycée, sous-groupes de classe),
  // jamais renseignées automatiquement tant que D02 reste ouvert.
  serie          String?
  groupe         String?
  capacite       Int?
  // Lot 7 : classe pilote pour tester l'appel et le pointage (une seule à la fois, garanti par le service).
  pilote         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  enrollments       Enrollment[]
  assignments       TeachingAssignment[]
  timetableEntries  TimetableEntry[]
  attendanceCalls   AttendanceCall[]
  sessionCheckins   TeacherSessionCheckin[]
  announcements     Announcement[]
  disciplineRecords DisciplineRecord[]
  evaluations       Evaluation[]
  bulletinPeriods   BulletinPeriod[]
  textbookEntries   TextbookEntry[]

  @@unique([levelId, academicYearId, nom])
  @@map("classes")
}

// --- Utilisateurs, rôles, permissions ---------------------------------------
// Permissions fines (pas seulement par rôle) : un Role est une collection de Permission,
// vérifiée à chaque requête sensible par un guard serveur, jamais par le seul rôle affiché côté client.

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  nom         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

enum UserStatus {
  ACTIF
  INACTIF
}

model User {
  id                        String     @id @default(cuid())
  schoolId                  String
  school                    School     @relation(fields: [schoolId], references: [id])
  roleId                    String
  role                      Role       @relation(fields: [roleId], references: [id])
  nom                       String
  prenom                    String
  email                     String
  motDePasseHash            String
  statut                    UserStatus @default(ACTIF)
  dernierLoginAt            DateTime?
  // Politique de verrouillage (§14) : compteur d'échecs consécutifs et verrou temporaire, jamais un blocage définitif.
  tentativesEchecsConnexion Int        @default(0)
  verrouilleJusqua          DateTime?
  // Récupération administrée (§8) : un admin fixe un mot de passe temporaire, l'utilisateur doit le changer à la connexion suivante.
  doitChangerMotDePasse     Boolean    @default(false)
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  discountsProposed      Discount[]                 @relation("DiscountAuteur")
  discountsDecided       Discount[]                 @relation("DiscountApprobateur")
  paymentsRecus          Payment[]
  paymentsAnnules        Payment[]                  @relation("PaymentAnnulePar")
  documentsAnnules       IssuedDocument[]           @relation("DocumentAnnulePar")
  disciplineRecords      DisciplineRecord[]         @relation("DisciplineRecordAuteur")
  disciplineRevisions    DisciplineRecordRevision[]
  disciplineSanctions    Sanction[]                 @relation("SanctionDecidePar")
  disciplineConvocations DisciplineConvocation[]    @relation("ConvocationCreePar")
  expensesEffectuees     Expense[]                  @relation("ExpenseEffectuePar")
  expensesApprouvees     Expense[]                  @relation("ExpenseApprobateur")
  timetablesPublished    Timetable[]                @relation("TimetablePublishedBy")
  timetableExceptions    TimetableException[]       @relation("ExceptionCreatedBy")
  attendanceCalls        AttendanceCall[]           @relation("CallTakenBy")
  attendanceCorrections  AttendanceCorrection[]
  evaluationsCreees      Evaluation[]
  gradesSaisies          Grade[]
  gradeCorrections       GradeCorrection[]
  textbookEntries        TextbookEntry[]
  justificationsDeclared AbsenceJustification[]     @relation("JustificationDeclaredBy")
  justificationsDecided  AbsenceJustification[]     @relation("JustificationDecidedBy")
  teacher                Teacher?                   @relation("TeacherUser")
  checkinsDecided        TeacherSessionCheckin[]    @relation("SessionCheckinDecidedBy")
  dayCheckinsDecided     TeacherDayCheckin[]        @relation("DayCheckinDecidedBy")
  activationCodesCreated ParentActivationCode[]
  threadsAsStaff         MessageThread[]            @relation("ThreadStaff")
  messagesAuthored       Message[]                  @relation("MessageAuthorUser")
  messagesWithdrawn      Message[]                  @relation("MessageWithdrawnBy")
  reportsFiled           MessageReport[]            @relation("ReportReporter")
  reportsHandled         MessageReport[]            @relation("ReportHandler")
  announcementsAuthored  Announcement[]             @relation("AnnouncementAuthor")
  announcementsWithdrawn Announcement[]             @relation("AnnouncementWithdrawnBy")

  @@unique([schoolId, email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// --- Séquences numériques atomiques ------------------------------------------
// RG10 (par extension aux matricules/numéros d'inscription, avant même les reçus du Lot 4) :
// un numéro généré ici est unique et jamais réutilisé. `scope` vaut "" pour une séquence non
// rattachée à une année (matricule, permanent) ou l'id d'une AcademicYear (numéro d'inscription,
// par année) — chaîne vide plutôt que `null` pour rester utilisable dans une contrainte unique.

model NumberSequence {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  type          String
  scope         String   @default("")
  dernierNumero Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, type, scope])
  @@map("number_sequences")
}

// --- Élèves, responsables, inscriptions (Lot 2) -----------------------------
// Aucun montant, facture ni paiement ici (Lots 3-4) : plusieurs règles dont ils dépendent
// restent ouvertes (DECISIONS_PENDING.md). "Alerte impayés antérieurs" à la réinscription
// (cadrage §4.2) n'est donc pas encore implémentable — reportée au Lot 4.

enum Sexe {
  M
  F
}

enum StudentStatus {
  ACTIF
  INACTIF
}

model Student {
  id            String        @id @default(cuid())
  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id])
  matricule     String
  nom           String
  prenom        String
  sexe          Sexe
  // Facultative (demande explicite, 22 septembre 2026) : pour faciliter l'enregistrement, un dossier
  // peut être créé sans date de naissance connue, à compléter plus tard via PATCH /students/:id. Un
  // document officiel (attestation, carte) refuse tant qu'elle manque (DocumentsService.issueForEnrollment).
  dateNaissance DateTime?
  // Lot 19 : figure sur l'attestation de scolarité ; facultatif (dossiers antérieurs).
  lieuNaissance String?
  nationalite   String?
  // Lot 19 : nom du fichier de la photo, stocké HORS du dossier public (private-uploads/students) : jamais servi par
  // /uploads, uniquement par GET /students/:id/photo (authentifié).
  photoUrl      String?
  statut        StudentStatus @default(ACTIF)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  studentGuardians    StudentGuardian[]
  parentNotifications ParentNotification[]
  messageThreads      MessageThread[]
  enrollments         Enrollment[]
  attendanceRecords   AttendanceRecord[]
  grades              Grade[]
  bulletins           Bulletin[]
  issuedDocuments     IssuedDocument[]
  disciplineRecords   DisciplineRecord[]
  sanctions           Sanction[]
  convocations        DisciplineConvocation[]

  @@unique([schoolId, matricule])
  @@map("students")
}

model Guardian {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  // Tous facultatifs (demande explicite, 22 septembre 2026, même raison que Student.dateNaissance) :
  // un contact incomplet reste enregistrable, à compléter plus tard via PATCH /students/guardians/:id.
  // Sans téléphone, ce responsable ne peut identifier aucun autre responsable existant (le find-or-create
  // R9-like exige un numéro, voir StudentsService.create/attachGuardian) et ne peut recevoir de code
  // d'activation parent (ParentAccountsService.generateCode) : un nouveau Guardian est alors toujours créé.
  nom        String?
  prenom     String?
  telephone  String?
  email      String?
  profession String?
  adresse    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  studentGuardians StudentGuardian[]
  parentAccount    ParentAccount?
  onlinePayments   OnlinePayment[]
  messageThreads   MessageThread[]
  activationCodes  ParentActivationCode[]

  // R9-like (cf. Elyon) : un même numéro identifie le même responsable au sein d'un établissement,
  // jamais par téléphone seul à travers plusieurs écoles (non pertinent ici, mono-établissement,
  // mais évite qu'un même parent soit dupliqué à chaque nouvel enfant inscrit).
  @@unique([schoolId, telephone])
  @@map("guardians")
}

model StudentGuardian {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id])
  guardianId     String
  guardian       Guardian  @relation(fields: [guardianId], references: [id])
  // Facultatif (demande explicite, 22 septembre 2026, même raison que Guardian) : un lien familial
  // encore inconnu au moment de la saisie, à compléter plus tard.
  lien           String?
  prioritaire    Boolean   @default(false)
  // Lot 11 (D67) : la Direction peut retirer l'accès au portail d'un responsable pour cet élève précis
  // (décision de justice, par exemple), avec motif et audit. Le lien familial, lui, ne change pas.
  accesPortail   Boolean   @default(true)
  accesModifieAt DateTime?
  accesMotif     String?
  createdAt      DateTime  @default(now())

  @@unique([studentId, guardianId])
  @@map("student_guardians")
}

enum EnrollmentType {
  INSCRIPTION
  REINSCRIPTION
}

enum EnrollmentStatus {
  ACTIVE
  ANNULEE
}

model Enrollment {
  id              String           @id @default(cuid())
  schoolId        String
  school          School           @relation(fields: [schoolId], references: [id])
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id])
  classId         String
  class           Class            @relation(fields: [classId], references: [id])
  academicYearId  String
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id])
  numero          String
  type            EnrollmentType
  statut          EnrollmentStatus @default(ACTIVE)
  dateInscription DateTime         @default(now())
  motifAnnulation String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  invoice Invoice?

  @@unique([schoolId, numero])
  @@map("enrollments")
}

// --- Tarifs, factures, remises (Lot 3) --------------------------------------
// Aucun paiement ici (Lot 4) : "montant payé" est donc toujours 0 pour l'instant.
// Le statut de solvabilité (cahier §6) reflète honnêtement cette absence — RG13, jamais une donnée
// inventée : tant que le Lot 4 n'existe pas, tout montant exigible apparaît normalement non couvert.

// D39 (DECISIONS_PENDING.md) : certains frais ne s'appliquent qu'à un type d'inscription précis
// (ex. "Frais d'inscription" pour un nouvel élève, "Frais de réinscription" pour un élève déjà
// connu) — jamais les deux à la fois pour la même inscription, `TOUS` reste le défaut pour un
// frais indifférent au type (ex. l'écolage).
enum FeeApplicability {
  TOUS
  INSCRIPTION
  REINSCRIPTION
}

model FeeType {
  id           String           @id @default(cuid())
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id])
  code         String
  nom          String
  obligatoire  Boolean          @default(true)
  avecTranches Boolean          @default(false)
  appliesTo    FeeApplicability @default(TOUS)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  feeSchedules FeeSchedule[]
  invoiceLines InvoiceLine[]

  @@unique([schoolId, code])
  @@map("fee_types")
}

model FeeSchedule {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  levelId        String
  level          Level        @relation(fields: [levelId], references: [id])
  feeTypeId      String
  feeType        FeeType      @relation(fields: [feeTypeId], references: [id])
  // Requis si feeType.avecTranches = false (montant unique). Ignoré sinon (voir InstallmentSchedule).
  montant        Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  installments InstallmentSchedule[]

  @@unique([academicYearId, levelId, feeTypeId])
  @@map("fee_schedules")
}

model InstallmentSchedule {
  id              String      @id @default(cuid())
  feeScheduleId   String
  feeSchedule     FeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)
  libelle         String
  montant         Int
  ordre           Int
  dateLimite      DateTime
  delaiGraceJours Int         @default(0)
  createdAt       DateTime    @default(now())

  @@unique([feeScheduleId, ordre])
  @@map("installment_schedules")
}

enum InvoiceStatus {
  EMISE
  ANNULEE
}

model Invoice {
  id           String        @id @default(cuid())
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id])
  enrollmentId String        @unique
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id])
  statut       InvoiceStatus @default(EMISE)
  dateEmission DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lines InvoiceLine[]

  @@map("invoices")
}

model InvoiceLine {
  id              String    @id @default(cuid())
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeTypeId       String
  feeType         FeeType   @relation(fields: [feeTypeId], references: [id])
  // Snapshot (RG03) : jamais recalculé après coup, même si le tarif change ensuite.
  libelle         String
  montant         Int
  dateEcheance    DateTime?
  delaiGraceJours Int       @default(0)
  ordre           Int       @default(0)
  createdAt       DateTime  @default(now())

  discounts      Discount[]
  payments       Payment[]
  onlinePayments OnlinePayment[]

  @@map("invoice_lines")
}

// --- Paiements et reçus (Lot 4) ---------------------------------------------
// Un paiement cible toujours une seule InvoiceLine, jamais réparti sur plusieurs (simplification
// délibérée qui évite tout le débat D12 sur la ventilation multi-lignes : le montant est toujours
// plafonné au solde restant de CETTE ligne, donc un trop-perçu au sens RG08 est structurellement
// impossible sans qu'un compte d'avance existe — voir DECISIONS_PENDING.md D41). Paiement partiel
// autorisé (D10, plusieurs paiements possibles sur la même ligne jusqu'à solde nul). RG09/RG18 :
// jamais modifié ni supprimé une fois VALIDE — une correction passe par ANNULE + motif (écriture
// inverse implicite, le solde de la ligne se recalcule simplement en excluant les paiements ANNULE).

enum PaymentMode {
  ESPECES
  MOBILE_MONEY
}

enum PaymentStatus {
  VALIDE
  ANNULE
}

enum OnlinePaymentStatus {
  EN_ATTENTE
  CONFIRME
  ECHOUE
  A_TRAITER
}

// Tentative de paiement en ligne d'une tranche par un parent. Le Payment (et son reçu séquentiel, RG10)
// ne naît qu'à la confirmation du fournisseur : une tentative échouée ou abandonnée ne consomme aucun numéro.
model OnlinePayment {
  id               String              @id @default(cuid())
  schoolId         String
  school           School              @relation(fields: [schoolId], references: [id])
  invoiceLineId    String
  invoiceLine      InvoiceLine         @relation(fields: [invoiceLineId], references: [id])
  guardianId       String
  guardian         Guardian            @relation(fields: [guardianId], references: [id])
  montant          Int
  // Numéro débité, au format international sans le plus.
  telephone        String
  // Identifiant envoyé au fournisseur (UUID), clé de rapprochement du retour signé.
  depositId        String              @unique
  statut           OnlinePaymentStatus @default(EN_ATTENTE)
  motifEchec       String?
  // Argent pris mais plus rien à imputer : clôturé par la Direction avec un motif.
  motifCloture     String?
  clotureParUserId String?
  paymentId        String?             @unique
  payment          Payment?            @relation(fields: [paymentId], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([invoiceLineId, statut])
  @@index([schoolId, statut])
  @@map("online_payments")
}

// --- Préinscription en ligne (Lot 21) --------------------------------------------

enum PreRegistrationStatus {
  EN_ATTENTE
  ACCEPTEE
  REJETEE
}

/**
 * Demande déposée par une famille avant qu'aucun élève n'existe (formulaire public, sans compte). Le secrétariat
 * l'examine puis, en l'acceptant, choisit la classe réelle et déclenche la création de l'élève et de son inscription
 * (mêmes garde-fous que la saisie manuelle : doublon D33, numéro de matricule, facture). Aucun frais de dossier ici
 * (D04 non tranchée) : ce n'est qu'une demande, jamais un engagement financier.
 */
model PreRegistration {
  id                   String                @id @default(cuid())
  schoolId             String
  school               School                @relation(fields: [schoolId], references: [id])
  reference            String                @unique
  nom                  String
  prenom               String
  sexe                 Sexe
  dateNaissance        DateTime
  lieuNaissance        String?
  nationalite          String?
  levelId              String
  level                Level                 @relation(fields: [levelId], references: [id])
  responsableNom       String
  responsablePrenom    String
  responsableTelephone String
  responsableEmail     String?
  message              String?
  statut               PreRegistrationStatus @default(EN_ATTENTE)
  motifRejet           String?
  studentId            String?
  enrollmentId         String?
  traiteParUserId      String?
  traiteLe             DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([statut, createdAt])
  @@index([responsableTelephone])
  @@map("pre_registrations")
}

// --- Discipline (Lot 20) --------------------------------------------------------

enum DisciplineNature {
  INCIDENT
  VALORISATION
}

enum DisciplineGravite {
  LEGER
  MOYEN
  GRAVE
}

enum DisciplineRecordStatus {
  OUVERT
  TRAITE
  ANNULE
}

enum SanctionStatus {
  DECIDEE
  PUBLIEE
  ANNULEE
}

enum ConvocationStatus {
  ENVOYEE
  ANNULEE
}

enum ConvocationIssue {
  PRESENT
  ABSENT
}

// Catalogue des types de signalement, saisi par l'école (aucune valeur préchargée : le règlement est le sien).
model DisciplineType {
  id        String           @id @default(cuid())
  nature    DisciplineNature
  nom       String
  actif     Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  records DisciplineRecord[]

  @@unique([nature, nom])
  @@map("discipline_types")
}

// Catalogue des sanctions possibles (avertissement, retenue...), saisi par l'école.
model SanctionType {
  id        String   @id @default(cuid())
  nom       String   @unique
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sanctions Sanction[]

  @@map("sanction_types")
}

/**
 * Signalement d'un incident ou d'une valorisation. La classe et l'année sont figées à la saisie. La description est une
 * donnée sensible de mineur : jamais dans le journal, jamais dans le portail des parents, jamais dans une notification.
 */
model DisciplineRecord {
  id              String                 @id @default(cuid())
  studentId       String
  student         Student                @relation(fields: [studentId], references: [id])
  classId         String
  class           Class                  @relation(fields: [classId], references: [id])
  academicYearId  String
  academicYear    AcademicYear           @relation(fields: [academicYearId], references: [id])
  nature          DisciplineNature
  typeId          String
  type            DisciplineType         @relation(fields: [typeId], references: [id])
  dateFaits       DateTime               @db.Date
  gravite         DisciplineGravite?
  description     String
  auteurUserId    String
  auteur          User                   @relation("DisciplineRecordAuteur", fields: [auteurUserId], references: [id])
  statut          DisciplineRecordStatus @default(OUVERT)
  // Classé sans suite (incident traité sans sanction) ou annulé : motif obligatoire.
  motifClassement String?
  motifAnnulation String?
  annuleParUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  revisions    DisciplineRecordRevision[]
  sanctions    Sanction[]
  convocations DisciplineConvocation[]
  school       School?                    @relation(fields: [schoolId], references: [id])
  schoolId     String?

  @@index([studentId, dateFaits])
  @@index([auteurUserId])
  @@index([academicYearId, statut])
  @@map("discipline_records")
}

// Historique append-only d'une correction (avant le jour de saisie révolu : par la Direction, avec un motif).
model DisciplineRecordRevision {
  id        String           @id @default(cuid())
  recordId  String
  record    DisciplineRecord @relation(fields: [recordId], references: [id])
  avant     Json
  motif     String
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  createdAt DateTime         @default(now())

  @@index([recordId])
  @@map("discipline_record_revisions")
}

/**
 * Sanction décidée par la Direction pour un incident. Le parent ne la voit qu'une fois PUBLIEE : `messageFamille` est le
 * seul texte libre qui lui est montré, rédigé pour lui.
 */
model Sanction {
  id              String           @id @default(cuid())
  recordId        String
  record          DisciplineRecord @relation(fields: [recordId], references: [id])
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id])
  typeId          String
  type            SanctionType     @relation(fields: [typeId], references: [id])
  dateDebut       DateTime         @db.Date
  dateFin         DateTime?        @db.Date
  messageFamille  String?
  statut          SanctionStatus   @default(DECIDEE)
  decideParUserId String
  decidePar       User             @relation("SanctionDecidePar", fields: [decideParUserId], references: [id])
  publieLe        DateTime?
  publieParUserId String?
  annuleLe        DateTime?
  motifAnnulation String?
  annuleParUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([studentId, statut])
  @@index([recordId])
  @@map("sanctions")
}

// Convocation d'une famille. Le parent voit la date, le lieu et l'objet, et accuse réception depuis le portail.
model DisciplineConvocation {
  id                  String            @id @default(cuid())
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id])
  // Incident à l'origine : lien interne, jamais montré au parent.
  recordId            String?
  record              DisciplineRecord? @relation(fields: [recordId], references: [id])
  dateRdv             DateTime
  lieu                String
  objet               String
  statut              ConvocationStatus @default(ENVOYEE)
  creeParUserId       String
  creePar             User              @relation("ConvocationCreePar", fields: [creeParUserId], references: [id])
  accuseLe            DateTime?
  accuseParGuardianId String?
  issue               ConvocationIssue?
  issueLe             DateTime?
  annuleLe            DateTime?
  motifAnnulation     String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([studentId, dateRdv])
  @@map("discipline_convocations")
}

// --- Documents officiels (Lot 19) ---------------------------------------------

enum DocumentType {
  ATTESTATION_SCOLARITE
  CARTE_ELEVE
}

enum DocumentIssuer {
  STAFF
  PARENT
}

/**
 * Document officiel émis (attestation de scolarité, carte d'élève). Le contenu est FIGÉ dans `snapshot` au moment de
 * l'émission : une réimpression donne exactement le même document, même si l'élève a changé de classe depuis. Le numéro
 * est séquentiel et jamais réutilisé ; le jeton (`verificationToken`) est aléatoire, et seul lui figure dans le QR code :
 * un numéro devinable ne permet jamais de balayer les documents de l'école. Un seul document actif par élève, type et
 * année (garanti par le service, sous verrou de la ligne élève) : émettre deux fois ne consomme pas de numéro.
 */
model IssuedDocument {
  id                String         @id @default(cuid())
  schoolId          String
  school            School         @relation(fields: [schoolId], references: [id])
  studentId         String
  student           Student        @relation(fields: [studentId], references: [id])
  academicYearId    String
  academicYear      AcademicYear   @relation(fields: [academicYearId], references: [id])
  type              DocumentType
  numero            String
  verificationToken String         @unique @default(cuid())
  snapshot          Json
  emisParType       DocumentIssuer
  // Identifiant du membre du personnel ou du responsable selon `emisParType` (pas de clé étrangère : deux tables possibles).
  emisParId         String?
  dateEmission      DateTime       @default(now())
  annuleLe          DateTime?
  motifAnnulation   String?
  annuleParUserId   String?
  annuleParUser     User?          @relation("DocumentAnnulePar", fields: [annuleParUserId], references: [id])

  @@unique([schoolId, numero])
  @@index([studentId, type])
  @@map("issued_documents")
}

model Payment {
  id                String         @id @default(cuid())
  schoolId          String
  school            School         @relation(fields: [schoolId], references: [id])
  invoiceLineId     String
  invoiceLine       InvoiceLine    @relation(fields: [invoiceLineId], references: [id])
  numeroRecu        String
  // Vérification d'authenticité du reçu (D29) : jeton aléatoire distinct de numeroRecu (séquentiel
  // et donc devinable) — sert de clé pour GET /payments/verify/:token, un endpoint public qui ne
  // doit jamais permettre d'énumérer tous les reçus de l'école en incrémentant un numéro.
  verificationToken String         @unique @default(cuid())
  // Encaissement saisi sans Internet (D49) : numéro du reçu PROVISOIRE remis au parent (généré sur
  // l'appareil, jamais un numéro officiel) et instant réel de la saisie. Le reçu officiel REC-xxxxxx
  // n'est attribué qu'à la synchronisation, par le serveur (RG10 inchangée).
  numeroProvisoire  String?
  saisieHorsLigneAt DateTime?
  montant           Int
  modePaiement      PaymentMode    @default(ESPECES)
  // Renseignée uniquement pour MOBILE_MONEY (référence externe de la transaction) — jamais
  // d'intégration API automatisée, un simple enregistrement manuel (cahier §11, déjà tranché).
  referenceExterne  String?
  datePaiement      DateTime       @default(now())
  // Vide pour un paiement en ligne confirmé par le fournisseur (aucun encaisseur du personnel).
  recuParUserId     String?
  recuParUser       User?          @relation(fields: [recuParUserId], references: [id])
  onlinePayment     OnlinePayment?
  statut            PaymentStatus  @default(VALIDE)
  motifAnnulation   String?
  annuleParUserId   String?
  annuleParUser     User?          @relation("PaymentAnnulePar", fields: [annuleParUserId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([schoolId, numeroRecu])
  @@unique([schoolId, numeroProvisoire])
  @@map("payments")
}

enum DiscountType {
  MONTANT_FIXE
  POURCENTAGE
}

enum DiscountStatus {
  EN_ATTENTE
  APPROUVEE
  REJETEE
}

model Discount {
  id            String         @id @default(cuid())
  invoiceLineId String
  invoiceLine   InvoiceLine    @relation(fields: [invoiceLineId], references: [id])
  type          DiscountType
  valeur        Int
  motif         String
  statut        DiscountStatus @default(EN_ATTENTE)
  auteurId      String
  auteur        User           @relation("DiscountAuteur", fields: [auteurId], references: [id])
  approbateurId String?
  approbateur   User?          @relation("DiscountApprobateur", fields: [approbateurId], references: [id])
  motifRejet    String?
  dateDecision  DateTime?
  createdAt     DateTime       @default(now())

  @@map("discounts")
}

// --- Journal d'audit (append-only) ------------------------------------------
// RG15 : toute action sensible est journalisée avec utilisateur, horodatage, ancienne et nouvelle valeur.
// Aucune méthode de mise à jour/suppression n'est exposée par le service applicatif (voir AuditService).

// Clé d'idempotence (en-tête Idempotency-Key) : rejouer une requête déjà traitée renvoie la réponse
// d'origine au lieu de refaire l'opération — indispensable à la synchronisation hors ligne, où une
// réponse perdue par le réseau fait renvoyer la même saisie. Sans clé étrangère (simple journal).
model IdempotencyRecord {
  id         String   @id @default(cuid())
  userId     String
  key        String
  method     String
  path       String
  statusCode Int
  response   Json?
  createdAt  DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

model AuditLog {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  action         String
  entite         String
  entiteId       String?
  ancienneValeur Json?
  nouvelleValeur Json?
  createdAt      DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([entite, entiteId])
  @@map("audit_logs")
}

// --- Sorties financières (Lot 5) ---------------------------------------------
// D24 (DECISIONS_PENDING.md) : catégorie fermée mais volontairement PAS un enum Postgres — une
// simple chaîne validée côté DTO (`EXPENSE_CATEGORIES`) pour rester "paramétrable" sans migration
// si l'école demande une catégorie de plus. D25 : toute sortie exige une validation Direction
// (seuil = 0, provisoire) avant d'être comptée comme une vraie sortie de caisse.

enum ExpenseStatus {
  EN_ATTENTE
  APPROUVEE
  REJETEE
}

model Expense {
  id            String        @id @default(cuid())
  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id])
  categorie     String
  montant       Int
  description   String
  dateDepense   DateTime      @default(now())
  statut        ExpenseStatus @default(EN_ATTENTE)
  effectueParId String
  effectuePar   User          @relation("ExpenseEffectuePar", fields: [effectueParId], references: [id])
  approbateurId String?
  approbateur   User?         @relation("ExpenseApprobateur", fields: [approbateurId], references: [id])
  motifRejet    String?
  dateDecision  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("expenses")
}

// --- Lot 7 : référentiel pédagogique et personnel (addendum v1.1, décisions D52 à D56) -----------
// Rien n'est prérempli : horaires, matières, enseignants, dates sont saisis par la Direction.

enum TimeSlotType {
  COURS
  PAUSE
}

// Créneau horaire. `sectionId` nul = grille commune à toutes les sections (D53) ; renseigné = grille
// propre à cette section, qui remplace alors la grille commune pour elle. Heures au format "HH:mm"
// (heure locale de l'établissement), jamais un fuseau : un créneau est une heure murale récurrente.
model TimeSlot {
  id         String       @id @default(cuid())
  schoolId   String
  school     School       @relation(fields: [schoolId], references: [id])
  sectionId  String?
  section    Section?     @relation(fields: [sectionId], references: [id])
  libelle    String
  heureDebut String
  heureFin   String
  type       TimeSlotType @default(COURS)
  ordre      Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  timetableEntries TimetableEntry[]

  @@map("time_slots")
}

model Room {
  id               String               @id @default(cuid())
  schoolId         String
  school           School               @relation(fields: [schoolId], references: [id])
  nom              String
  capacite         Int?
  actif            Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  timetableEntries TimetableEntry[]
  exceptions       TimetableException[] @relation("ExceptionRoom")
  pointageCode     PointageCode?

  @@unique([schoolId, nom])
  @@map("rooms")
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  code      String
  nom       String
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levels           SubjectLevel[]
  teachers         TeacherSubject[]
  assignments      TeachingAssignment[]
  timetableEntries TimetableEntry[]
  attendanceCalls  AttendanceCall[]
  evaluations      Evaluation[]
  textbookEntries  TextbookEntry[]

  @@unique([schoolId, code])
  @@map("subjects")
}

// Matière enseignée à un niveau (donc à sa section, le niveau appartenant à un cycle d'une section).
model SubjectLevel {
  id                String  @id @default(cuid())
  subjectId         String
  subject           Subject @relation(fields: [subjectId], references: [id])
  levelId           String
  level             Level   @relation(fields: [levelId], references: [id])
  // Volume hebdomadaire indicatif, facultatif (jamais imposé).
  minutesParSemaine Int?
  // Lot 15 : coefficient de la matière dans la moyenne générale de ce niveau (défaut 1, modifiable par la Direction).
  coefficient       Int     @default(1)

  @@unique([subjectId, levelId])
  @@map("subject_levels")
}

enum TeacherStatus {
  ACTIF
  INACTIF
}

// Fiche enseignant (D56). Le compte utilisateur (rôle ENSEIGNANT) sera rattaché aux lots suivants ;
// aucune donnée de paie ni de contrat, par décision.
model Teacher {
  id               String        @id @default(cuid())
  schoolId         String
  school           School        @relation(fields: [schoolId], references: [id])
  nom              String
  prenom           String
  telephone        String?
  email            String?
  statut           TeacherStatus @default(ACTIF)
  // Enseignant volontaire pour la classe pilote (D-liste "à fournir").
  volontairePilote Boolean       @default(false)
  // Compte utilisateur avec lequel l'enseignant pointe (un compte, une fiche).
  userId           String?       @unique
  user             User?         @relation("TeacherUser", fields: [userId], references: [id])
  // SEANCE : il scanne le QR de la salle au début et à la fin de chaque cours (collège, lycée).
  // JOURNEE : il scanne le QR de l'entrée à l'arrivée et au départ (maternelle, primaire).
  modePointage     PointageMode  @default(SEANCE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  subjects        TeacherSubject[]
  assignments     TeachingAssignment[]
  evaluations     Evaluation[]
  textbookEntries TextbookEntry[]

  timetableEntries TimetableEntry[]
  replacements     TimetableException[] @relation("ExceptionReplacementTeacher")

  attendanceCalls AttendanceCall[]

  sessionCheckins TeacherSessionCheckin[]
  dayCheckins     TeacherDayCheckin[]

  @@map("teachers")
}

model TeacherSubject {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}

// Affectation : qui enseigne quelle matière dans quelle classe. Un seul enseignant par classe et par
// matière (RV01 : pas de co-enseignement en vague 1).
model TeachingAssignment {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId])
  @@map("teaching_assignments")
}

// Trimestre (D55) : dates saisies par la Direction chaque année, jamais codées.
model Term {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  libelle        String
  dateDebut      DateTime     @db.Date
  dateFin        DateTime     @db.Date
  ordre          Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  evaluations     Evaluation[]
  bulletinPeriods BulletinPeriod[]

  @@unique([academicYearId, ordre])
  @@map("terms")
}

enum CalendarEventType {
  VACANCES
  FERIE
  AUTRE
}

// Jour sans classe : vacances, jour férié, autre fermeture. Saisi à la main, sans calendrier
// national préchargé (D55).
model CalendarEvent {
  id             String            @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id])
  type           CalendarEventType
  libelle        String
  dateDebut      DateTime          @db.Date
  dateFin        DateTime          @db.Date
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("calendar_events")
}

// --- Lot 8 : emploi du temps (addendum v1.1, RV01 à RV03) ---------------------------------------
// Un emploi du temps est versionné par année scolaire : une version est un BROUILLON modifiable, puis
// PUBLIÉE (immuable, avec une date d'effet), puis ARCHIVÉE quand une version plus récente la remplace.
// Les changements ponctuels (annulation, remplacement, changement de salle) ne créent jamais de
// version : ce sont des exceptions datées qui s'ajoutent à la version en vigueur ce jour-là.

enum TimetableStatus {
  BROUILLON
  PUBLIE
  ARCHIVE
}

model Timetable {
  id              String          @id @default(cuid())
  academicYearId  String
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])
  numero          Int
  statut          TimetableStatus @default(BROUILLON)
  // Renseignées à la publication : premier jour où cette version s'applique.
  dateEffet       DateTime?       @db.Date
  datePublication DateTime?
  publieParId     String?
  publiePar       User?           @relation("TimetablePublishedBy", fields: [publieParId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  entries TimetableEntry[]

  @@unique([academicYearId, numero])
  @@map("timetables")
}

// Séance hebdomadaire récurrente (RV01) : une classe, une matière, un enseignant, une salle. Les heures
// sont copiées du créneau au moment de la saisie : modifier le créneau plus tard ne réécrit jamais
// une version publiée (le service refuse d'ailleurs de modifier un créneau utilisé).
model TimetableEntry {
  id          String    @id @default(cuid())
  timetableId String
  timetable   Timetable @relation(fields: [timetableId], references: [id])
  classId     String
  class       Class     @relation(fields: [classId], references: [id])
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id])
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  timeSlotId  String
  timeSlot    TimeSlot  @relation(fields: [timeSlotId], references: [id])
  // 0 = dimanche ... 6 = samedi, comme School.joursClasse.
  jourSemaine Int
  heureDebut  String
  heureFin    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  exceptions      TimetableException[]
  attendanceCalls AttendanceCall[]
  sessionCheckins TeacherSessionCheckin[]

  @@index([timetableId])
  @@map("timetable_entries")
}

enum TimetableExceptionType {
  ANNULEE
  REMPLACEE
  SALLE_MODIFIEE
}

// Changement ponctuel d'une séance à une date précise. Ne modifie jamais la version d'emploi du temps.
model TimetableException {
  id                   String                 @id @default(cuid())
  entryId              String
  entry                TimetableEntry         @relation(fields: [entryId], references: [id])
  date                 DateTime               @db.Date
  type                 TimetableExceptionType
  replacementTeacherId String?
  replacementTeacher   Teacher?               @relation("ExceptionReplacementTeacher", fields: [replacementTeacherId], references: [id])
  roomId               String?
  room                 Room?                  @relation("ExceptionRoom", fields: [roomId], references: [id])
  motif                String
  createdById          String
  createdBy            User                   @relation("ExceptionCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime               @default(now())

  @@unique([entryId, date])
  @@map("timetable_exceptions")
}

// --- Lot 9 : assiduité des élèves (addendum v1.1, RV04, RV05) -----------------------------------
// Un appel porte sur une séance de l'emploi du temps à une date donnée ; il a un enregistrement par
// élève inscrit dans la classe. Par défaut tout le monde est présent (D60). Le statut est calculé
// par le serveur d'après le seuil de retard (RV05), jamais saisi tel quel.

enum AttendanceStatus {
  PRESENT
  RETARD
  ABSENT
}

enum JustificationStatus {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

// Motifs d'absence saisis par la Direction (D58). Aucun motif n'est prérempli.
model AbsenceReason {
  id        String   @id @default(cuid())
  libelle   String   @unique
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  justifications AbsenceJustification[]

  @@map("absence_reasons")
}

model AttendanceCall {
  id                String         @id @default(cuid())
  entryId           String
  entry             TimetableEntry @relation(fields: [entryId], references: [id])
  date              DateTime       @db.Date
  // Instantané de la séance au moment de l'appel : l'enseignant est celui qui tenait réellement la
  // séance ce jour-là (remplaçant compris), et les heures ne bougent plus si l'emploi du temps change.
  classId           String
  class             Class          @relation(fields: [classId], references: [id])
  subjectId         String
  subject           Subject        @relation(fields: [subjectId], references: [id])
  teacherId         String
  teacher           Teacher        @relation(fields: [teacherId], references: [id])
  heureDebut        String
  heureFin          String
  takenById         String
  takenBy           User           @relation("CallTakenBy", fields: [takenById], references: [id])
  takenAt           DateTime       @default(now())
  // Heure de saisie sur l'appareil quand l'appel a été fait sans Internet (comme les encaissements).
  saisieHorsLigneAt DateTime?
  updatedAt         DateTime       @updatedAt

  records AttendanceRecord[]

  @@unique([entryId, date])
  @@index([classId, date])
  @@map("attendance_calls")
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  callId        String
  call          AttendanceCall   @relation(fields: [callId], references: [id])
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id])
  statut        AttendanceStatus @default(PRESENT)
  minutesRetard Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  justification AbsenceJustification?
  corrections   AttendanceCorrection[]

  @@unique([callId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}

// Historique des corrections faites après le verrouillage (D59) ou par un autre que l'auteur : ce qui
// a changé, par qui, pourquoi. Une ligne de cette table n'est jamais modifiée.
model AttendanceCorrection {
  id             String           @id @default(cuid())
  recordId       String
  record         AttendanceRecord @relation(fields: [recordId], references: [id])
  ancienStatut   AttendanceStatus
  ancienMinutes  Int?
  nouveauStatut  AttendanceStatus
  nouveauMinutes Int?
  motif          String
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([recordId])
  @@map("attendance_corrections")
}

model AbsenceJustification {
  id                  String              @id @default(cuid())
  recordId            String              @unique
  record              AttendanceRecord    @relation(fields: [recordId], references: [id])
  reasonId            String?
  reason              AbsenceReason?      @relation(fields: [reasonId], references: [id])
  commentaire         String?
  statut              JustificationStatus @default(EN_ATTENTE)
  // Déclarée après le délai paramétré (D58) : signalé, pas refusé d'office quand la vie scolaire la saisit.
  horsDelai           Boolean             @default(false)
  declaredById        String
  declaredBy          User                @relation("JustificationDeclaredBy", fields: [declaredById], references: [id])
  declaredAt          DateTime            @default(now())
  decidedById         String?
  decidedBy           User?               @relation("JustificationDecidedBy", fields: [decidedById], references: [id])
  decidedAt           DateTime?
  decisionCommentaire String?

  @@map("absence_justifications")
}

// --- Lot 10 : pointage des enseignants par QR code (addendum v1.1, RV06, RV07) ------------------
// Un enseignant scanne avec son compte : le pointage naît « en attente » et un tiers le valide (RV06,
// jamais lui-même). Les heures effectuées se calculent d'après les pointages validés (RV07).

enum PointageMode {
  SEANCE
  JOURNEE
}

enum CheckinStatus {
  EN_ATTENTE
  VALIDE
  REJETE
}

enum CheckinSource {
  SCAN
  MANUEL
}

// Code imprimé en QR. roomId renseigné : le QR d'une salle ; sinon : le QR de l'entrée de l'école (un
// seul). Le jeton ne sort jamais des routes réservées à la gestion : le lire à distance annulerait la
// preuve de présence. Le régénérer invalide l'ancien QR affiché.
model PointageCode {
  id        String   @id @default(cuid())
  roomId    String?  @unique
  room      Room?    @relation(fields: [roomId], references: [id])
  token     String   @unique
  createdAt DateTime @default(now())

  @@map("pointage_codes")
}

// Pointage d'une séance (mode SEANCE). Les heures prévues sont un instantané ; les heures pointées sont
// celles du scan (heure de l'appareil quand le scan a été fait sans Internet, heure de réception à part).
model TeacherSessionCheckin {
  id            String         @id @default(cuid())
  teacherId     String
  teacher       Teacher        @relation(fields: [teacherId], references: [id])
  entryId       String
  entry         TimetableEntry @relation(fields: [entryId], references: [id])
  date          DateTime       @db.Date
  classId       String
  class         Class          @relation(fields: [classId], references: [id])
  heureDebut    String
  heureFin      String
  debutAt       DateTime?
  finAt         DateTime?
  debutRecuAt   DateTime?
  finRecuAt     DateTime?
  retardMinutes Int?
  // Le QR scanné n'était pas celui de la salle prévue ce jour-là : à vérifier par le validateur.
  ecartSalle    Boolean        @default(false)
  source        CheckinSource  @default(SCAN)
  statut        CheckinStatus  @default(EN_ATTENTE)
  decidedById   String?
  decidedBy     User?          @relation("SessionCheckinDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  motif         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([entryId, date])
  @@index([teacherId, date])
  @@map("teacher_session_checkins")
}

// Pointage d'une journée (mode JOURNEE) : arrivée et départ, sans lien avec les séances.
model TeacherDayCheckin {
  id            String        @id @default(cuid())
  teacherId     String
  teacher       Teacher       @relation(fields: [teacherId], references: [id])
  date          DateTime      @db.Date
  arriveeAt     DateTime?
  departAt      DateTime?
  arriveeRecuAt DateTime?
  departRecuAt  DateTime?
  // Heure de la première séance du jour, si l'emploi du temps en prévoit une (sinon pas de retard calculable).
  heurePrevue   String?
  retardMinutes Int?
  source        CheckinSource @default(SCAN)
  statut        CheckinStatus @default(EN_ATTENTE)
  decidedById   String?
  decidedBy     User?         @relation("DayCheckinDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  motif         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([teacherId, date])
  @@map("teacher_day_checkins")
}

// --- Lot 11 : comptes parents et portail en lecture (addendum v1.1, RV08, RV10) ------------------
// Un compte parent n'est PAS un User : il a sa propre table, son propre jeton (clé distincte, marqueur
// « parent ») et sa propre garde. Un jeton de parent n'ouvre donc aucune route du personnel, y compris
// celles qui n'exigent qu'un utilisateur connecté, et inversement. Il est relié à un responsable
// (Guardian) déjà enregistré : pas de création libre (D66).

model ParentAccount {
  id                        String     @id @default(cuid())
  guardianId                String     @unique
  guardian                  Guardian   @relation(fields: [guardianId], references: [id])
  motDePasseHash            String
  statut                    UserStatus @default(ACTIF)
  tentativesEchecsConnexion Int        @default(0)
  verrouilleJusqua          DateTime?
  dernierLoginAt            DateTime?
  activatedAt               DateTime   @default(now())
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  refreshTokens           ParentRefreshToken[]
  consents                ParentConsent[]
  notifications           ParentNotification[]
  notificationPreferences ParentNotificationPreference[]
  pushSubscriptions       ParentPushSubscription[]

  @@map("parent_accounts")
}

model ParentRefreshToken {
  id        String        @id @default(cuid())
  accountId String
  account   ParentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime      @default(now())

  @@index([accountId])
  @@map("parent_refresh_tokens")
}

// Consentement du responsable (D76) : une ligne par acceptation, avec la version de la politique
// affichée à ce moment-là. Jamais modifiée.
model ParentConsent {
  id         String        @id @default(cuid())
  accountId  String
  account    ParentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  version    String
  acceptedAt DateTime      @default(now())

  @@index([accountId])
  @@map("parent_consents")
}

// Code remis en main propre par le secrétariat. Seule son empreinte est conservée ; il est à usage
// unique, expire, et se brûle après quelques essais faux.
model ParentActivationCode {
  id          String    @id @default(cuid())
  guardianId  String
  guardian    Guardian  @relation(fields: [guardianId], references: [id])
  codeHash    String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  tentatives  Int       @default(0)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([guardianId])
  @@map("parent_activation_codes")
}

// --- Lot 12 : notifications aux parents (addendum v1.1, D65, D69, D70, D71, RV10) ----------------
// Canal : message dans l'application (toujours) et notification push (gratuite, selon les préférences).
// Un canal externe ne transporte jamais de contenu sensible : ni motif d'absence, ni note, ni montant.
// Aucune notification financière en vague 1 (D70) : il n'y a donc pas de type pour cela.

enum NotificationType {
  ABSENCE
  RETARD
  ENSEIGNANT_ABSENT
  EMPLOI_DU_TEMPS_MODIFIE
  // Lot 13 : un message vient d'arriver (jamais son contenu, RV10) ; une annonce de classe est publiée.
  MESSAGE_RECU
  ANNONCE
  // Lot 15 : un bulletin vient d'être publié (jamais une note, RV10).
  BULLETIN_DISPONIBLE
  // Lot 16 : un devoir vient d'être donné (jamais son contenu dans l'alerte, RV10).
  DEVOIR_DONNE
  // Lot 20 : un élément de vie scolaire est disponible (sanction publiée, convocation) ; jamais le détail, RV10.
  DISCIPLINE
}

enum PushDelivery {
  EN_ATTENTE
  ENVOYE
  ECHEC
  // Le parent a coupé les alertes push pour ce type d'événement.
  DESACTIVE
  // Aucun appareil enregistré : la notification reste dans l'application.
  AUCUN_APPAREIL
  // Ajoutée à une notification récente non lue (regroupement) : pas de nouvelle alerte.
  GROUPE
}

model ParentNotification {
  id          String           @id @default(cuid())
  accountId   String
  account     ParentAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        NotificationType
  // Jour scolaire de l'événement (fuseau de l'école) : sert au regroupement des absences d'une journée.
  jour        DateTime         @db.Date
  titre       String
  // Détail lisible dans l'application authentifiée uniquement, jamais le motif, une note ou un montant.
  corps       String
  occurrences Int              @default(1)
  pushStatut  PushDelivery     @default(EN_ATTENTE)
  pushErreur  String?
  luAt        DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([accountId, luAt, createdAt])
  @@index([accountId, studentId, type, jour])
  @@map("parent_notifications")
}

// Préférences par parent et par type d'événement. Absent = alerte push activée (valeur par défaut).
model ParentNotificationPreference {
  id        String           @id @default(cuid())
  accountId String
  account   ParentAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      NotificationType
  push      Boolean          @default(true)

  @@unique([accountId, type])
  @@map("parent_notification_preferences")
}

model ParentPushSubscription {
  id        String        @id @default(cuid())
  accountId String
  account   ParentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  endpoint  String        @unique
  p256dh    String
  auth      String
  createdAt DateTime      @default(now())

  @@index([accountId])
  @@map("parent_push_subscriptions")
}

// --- Lot 13 : messagerie sécurisée et annonces (addendum v1.1, RV09, RV11, D72 à D75) ------------
// Une conversation relie UN responsable et UN interlocuteur du personnel, à propos d'UN élève. Elle n'existe
// que si le couple est autorisé (RV09) : un enseignant affecté à la classe de l'enfant, ou l'école
// (Direction et vie scolaire). Jamais de parent à parent. Texte seul, aucun numéro échangé ni affiché.

enum ThreadKind {
  // Un enseignant précis (staffUserId).
  ENSEIGNANT
  // Le guichet de l'école : Direction et vie scolaire, partagé entre elles (staffUserId vide).
  ECOLE
}

enum MessageAuthor {
  PARENT
  PERSONNEL
}

// Priorité choisie par l'expéditeur, message par message. L'ordre de déclaration compte : Postgres trie les valeurs
// d'un enum dans cet ordre (NORMALE < IMPORTANTE < URGENTE), ce qui sert aux listes et à l'aperçu des non lus.
enum MessagePriority {
  NORMALE
  IMPORTANTE
  URGENTE
}

model MessageThread {
  id               String        @id @default(cuid())
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId       String
  guardian         Guardian      @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  type             ThreadKind
  staffUserId      String?
  staffUser        User?         @relation("ThreadStaff", fields: [staffUserId], references: [id])
  createdByType    MessageAuthor
  createdAt        DateTime      @default(now())
  dernierMessageAt DateTime      @default(now())
  // Dernière lecture de chaque côté : un message est non lu s'il est plus récent et vient de l'autre côté.
  parentLuAt       DateTime?
  personnelLuAt    DateTime?

  messages Message[]

  @@index([guardianId, dernierMessageAt])
  @@index([staffUserId, dernierMessageAt])
  @@index([studentId])
  @@map("message_threads")
}

model Message {
  id           String          @id @default(cuid())
  threadId     String
  thread       MessageThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  auteur       MessageAuthor
  // Renseigné pour un message du personnel ; le responsable est celui de la conversation.
  auteurUserId String?
  auteurUser   User?           @relation("MessageAuthorUser", fields: [auteurUserId], references: [id])
  texte        String
  // Un parent ne peut choisir que NORMALE ou IMPORTANTE (l'urgence immédiate passe par un appel à l'école).
  priorite     MessagePriority @default(NORMALE)
  createdAt    DateTime        @default(now())
  // Pas de suppression (D75) : la Direction retire un message avec un motif, la trace reste.
  retireAt     DateTime?
  retireParId  String?
  retirePar    User?           @relation("MessageWithdrawnBy", fields: [retireParId], references: [id])
  retireMotif  String?

  reports MessageReport[]

  @@index([threadId, createdAt])
  @@map("messages")
}

// Signalement d'un message à la Direction (D75), par un responsable ou un membre du personnel.
model MessageReport {
  id                   String        @id @default(cuid())
  messageId            String
  message              Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  signaleParType       MessageAuthor
  signaleParUserId     String?
  signaleParUser       User?         @relation("ReportReporter", fields: [signaleParUserId], references: [id])
  signaleParGuardianId String?
  motif                String?
  createdAt            DateTime      @default(now())
  traiteAt             DateTime?
  traiteParId          String?
  traitePar            User?         @relation("ReportHandler", fields: [traiteParId], references: [id])

  @@index([traiteAt, createdAt])
  @@index([messageId])
  @@map("message_reports")
}

// Annonce à tous les responsables des élèves d'une classe.
model Announcement {
  id          String    @id @default(cuid())
  classId     String
  class       Class     @relation(fields: [classId], references: [id])
  auteurId    String
  auteur      User      @relation("AnnouncementAuthor", fields: [auteurId], references: [id])
  titre       String
  corps       String
  createdAt   DateTime  @default(now())
  retireAt    DateTime?
  retireParId String?
  retirePar   User?     @relation("AnnouncementWithdrawnBy", fields: [retireParId], references: [id])
  retireMotif String?

  @@index([classId, createdAt])
  @@map("announcements")
}

// --- Lot 15 : notes, évaluations et bulletins (vague 2, D51) -------------------------------------------------------

enum GradeStatus {
  NOTE
  ABSENT
  DISPENSE
}

enum BulletinPeriodStatus {
  OUVERT
  VALIDE
  PUBLIE
}

// Évaluation d'une matière, dans une classe, pour un trimestre. L'enseignant est celui qui tient la matière dans la
// classe au moment de la création (affectation, RV01) ; il ne crée que pour ses propres affectations.
model Evaluation {
  id          String   @id @default(cuid())
  termId      String
  term        Term     @relation(fields: [termId], references: [id])
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  titre       String
  date        DateTime @db.Date
  // Barème (note maximale) : les notes sont ramenées sur 20 pour les moyennes. Coefficient de l'évaluation dans la
  // moyenne de sa matière.
  bareme      Int
  coefficient Int      @default(1)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grades Grade[]

  @@index([classId, subjectId, termId])
  @@map("evaluations")
}

// Note d'un élève à une évaluation. Absent ou dispensé : pas de valeur, et l'élève est exclu de la moyenne (jamais 0).
model Grade {
  id           String      @id @default(cuid())
  evaluationId String
  evaluation   Evaluation  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])
  statut       GradeStatus @default(NOTE)
  valeur       Decimal?    @db.Decimal(6, 2)
  saisiParId   String
  saisiPar     User        @relation(fields: [saisiParId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  corrections GradeCorrection[]

  @@unique([evaluationId, studentId])
  @@index([studentId])
  @@map("grades")
}

// Historique d'une correction après verrouillage (jamais modifié, motif obligatoire, même patron que RV04).
model GradeCorrection {
  id             String       @id @default(cuid())
  gradeId        String
  grade          Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  // null = la note n'existait pas encore (création après verrouillage).
  ancienStatut   GradeStatus?
  ancienneValeur Decimal?     @db.Decimal(6, 2)
  nouveauStatut  GradeStatus
  nouvelleValeur Decimal?     @db.Decimal(6, 2)
  motif          String
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([gradeId])
  @@map("grade_corrections")
}

// Appréciation de l'enseignant sur un élève pour une matière et un trimestre.
model SubjectAppreciation {
  id         String   @id @default(cuid())
  termId     String
  classId    String
  subjectId  String
  studentId  String
  texte      String
  saisiParId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([termId, classId, subjectId, studentId])
  @@map("subject_appreciations")
}

// État d'un trimestre pour une classe : OUVERT (saisie), VALIDE (figé par la Direction), PUBLIE (visible des parents).
model BulletinPeriod {
  id           String               @id @default(cuid())
  termId       String
  term         Term                 @relation(fields: [termId], references: [id])
  classId      String
  class        Class                @relation(fields: [classId], references: [id])
  statut       BulletinPeriodStatus @default(OUVERT)
  valideAt     DateTime?
  valideParId  String?
  publieAt     DateTime?
  publieParId  String?
  rouvertAt    DateTime?
  rouvertParId String?
  rouvertMotif String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  bulletins Bulletin[]

  @@unique([termId, classId])
  @@map("bulletin_periods")
}

// Instantané d'un bulletin, calculé à la validation : le parent voit ceci, jamais les notes en direct.
model Bulletin {
  id                   String         @id @default(cuid())
  periodId             String
  period               BulletinPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  studentId            String
  student              Student        @relation(fields: [studentId], references: [id])
  moyenneGenerale      Decimal?       @db.Decimal(5, 2)
  rang                 Int?
  effectif             Int
  moyenneClasse        Decimal?       @db.Decimal(5, 2)
  appreciationGenerale String?
  // Contenu figé : { matieres: [nom, coefficient, moyenne de l'élève, de la classe, min, max, lettre, appréciation],
  // general: { lettre, admis }, parametres: { affichageLettres, moyennePassage } }.
  lignes               Json
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([periodId, studentId])
  @@index([studentId])
  @@map("bulletins")
}

// Tranches de lettres (A à F) saisies par la Direction : `minimum` = moyenne sur 20 à partir de laquelle la lettre
// s'applique. Vide par défaut : aucune valeur inventée (D61).
model GradeBand {
  id      String  @id @default(cuid())
  lettre  String  @unique
  minimum Decimal @db.Decimal(5, 2)

  @@map("grade_bands")
}

// --- Lot 16 : cahier de textes et devoirs (vague 2, D51) -------------------------------------------------------------

// Une entrée du cahier de textes : ce qui a été fait en cours et/ou le travail à faire, pour une classe, une matière et un
// jour. Texte seul (aucune pièce jointe). `teacherId` est le titulaire de la matière dans la classe au moment de la
// création (affectation, RV01). Aucune clé vers l'emploi du temps : une version brouillon peut être supprimée.
model TextbookEntry {
  id           String    @id @default(cuid())
  classId      String
  class        Class     @relation(fields: [classId], references: [id])
  subjectId    String
  subject      Subject   @relation(fields: [subjectId], references: [id])
  teacherId    String
  teacher      Teacher   @relation(fields: [teacherId], references: [id])
  // Jour de la séance.
  date         DateTime  @db.Date
  contenu      String?
  devoirs      String?
  // Pour quand le devoir est à rendre ; jamais avant la date de la séance.
  dateEcheance DateTime? @db.Date
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([classId, date])
  @@map("textbook_entries")
}
