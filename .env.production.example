# Déploiement VPS (academy.lobima.online / api-academy.lobima.online) —
# copier en `.env.production` sur le VPS (jamais commité), à côté de
# docker-compose.yml. Chargé automatiquement par `docker compose --env-file`.

POSTGRES_USER=shakespeare
POSTGRES_PASSWORD=change-me-valeur-forte-reelle
POSTGRES_DB=shakespeare_academy

# Générer des valeurs aléatoires réelles, distinctes l'une de l'autre — ex.
# `openssl rand -hex 32`. Vides = login/refresh échouent explicitement
# (jamais un secret inventé, voir CLAUDE.md).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

WEB_ORIGIN=https://academy.lobima.online
NEXT_PUBLIC_API_URL=https://api-academy.lobima.online

# Surcharge le compte administrateur créé par `node dist/prisma/seed.js`
# (voir README) — sinon admin@shakespeareacademy.cg / ChangeMe123! par
# défaut, à changer immédiatement après le premier login en production.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
