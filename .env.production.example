# Déploiement VPS (ecole-shakespeare.com / api.ecole-shakespeare.com) —
# copier en `.env.production` sur le VPS (jamais commité), à côté de
# docker-compose.yml. Chargé automatiquement par `docker compose --env-file`.

POSTGRES_USER=shakespeare
POSTGRES_PASSWORD=change-me-valeur-forte-reelle
POSTGRES_DB=shakespeare_academy

# Générer des valeurs aléatoires réelles, distinctes l'une de l'autre — ex.
# `openssl rand -hex 32`. Vides = login/refresh échouent explicitement
# (jamais un secret inventé, voir CLAUDE.md).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

WEB_ORIGIN=https://ecole-shakespeare.com
NEXT_PUBLIC_API_URL=https://api.ecole-shakespeare.com

# Surcharge le compte administrateur créé par `node dist/prisma/seed.js`
# (voir README) — sinon admin@shakespeareacademy.cg / ChangeMe123! par
# défaut, à changer immédiatement après le premier login en production.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Alertes push aux parents (Lot 12, gratuites). Générer la paire sur le serveur, jamais dans le dépôt :
#   docker compose exec academy-api node -e "const w=require('web-push');console.log(w.generateVAPIDKeys())"
# Vides = aucune alerte push (les notifications restent dans l'application). Ne plus changer la paire
# une fois des parents abonnés : tous leurs appareils devraient se réabonner.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://ecole-shakespeare.com

# Paiement des frais par les parents (Lot 17, PawaPay). Compte PawaPay PROPRE à l'école : le retour signé
# est envoyé à l'adresse configurée dans le tableau de bord PawaPay du compte, donc jamais celui d'un autre projet.
# Adresse de retour à y déclarer : https://api.ecole-shakespeare.com/webhooks/payment/pawapay/deposit
# et activer « Signed Callbacks » (désactivé par défaut, sans cela aucun retour n'est accepté).
# Vide = paiement en ligne indisponible, même si l'Administrateur a activé l'interrupteur. Ne jamais commiter.
PAWAPAY_API_TOKEN=
# sandbox (essais, argent fictif) ou production (argent réel).
PAWAPAY_ENVIRONMENT=sandbox

# Assistant de rédaction de la messagerie (Lot 22, Claude Haiku 4.5) : propose un brouillon de réponse au personnel,
# jamais envoyé seul. Clé créée dans la console d'Anthropic (compte propre à l'école, plafond de dépense et rechargement
# automatique réglés là-bas), JAMAIS collée dans une conversation ni commitée. Vide = assistant non configuré : la
# messagerie fonctionne comme avant. L'assistant s'allume ensuite dans Vie scolaire, onglet « Assistant de messagerie ».
ANTHROPIC_API_KEY=
# Facultatif : autre modèle (par défaut claude-haiku-4-5-20251001). Si le tarif change, ASSISTANT_PRIX_ENTREE et
# ASSISTANT_PRIX_SORTIE donnent le prix en dollars par million de jetons (1 et 5 pour Haiku 4.5).
ASSISTANT_MODELE=
